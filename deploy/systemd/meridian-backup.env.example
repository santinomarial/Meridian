# Install as /etc/meridian/backup.env with mode 0600. Never commit real values.
# restic encrypts every object before it leaves the host.
RESTIC_REPOSITORY=s3:s3.example.com/meridian-production
RESTIC_PASSWORD_FILE=/etc/meridian/restic-password

# Prefer an instance role or provider-native credential file where available.
# If the selected backend requires environment credentials, set them here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
