# Copy to `.env` next to docker-compose.prod.yml on the VPS (never commit real secrets).
# Generate secrets before go-live — do not reuse laptop / staging values.
#
#   openssl rand -base64 48   # JWT_SECRET
#   openssl rand -base64 32   # POSTGRES_PASSWORD
#   openssl rand -hex 32      # LB_COOKIE_SECRET

# ── Public hostname (required for Caddy Let’s Encrypt) ────────────────────────
DOMAIN=app.example.com
# Required by the committed Caddyfile for ACME registration and notices
ACME_EMAIL=ops@example.com

# Must match the public HTTPS origin users open in the browser
CLIENT_ORIGIN=https://app.example.com

# ── Secrets (required) ────────────────────────────────────────────────────────
JWT_SECRET=
POSTGRES_PASSWORD=
# Stable HMAC key for Caddy's API-affinity cookie. Changing it remaps sessions.
LB_COOKIE_SECRET=

# API upstreams consumed by Caddy. Keep the single-replica default unless the
# documented multi-replica requirements are satisfied. Space-separate multiple
# stable service names, for example: api-a:3000 api-b:3000
API_UPSTREAMS=api:3000

# ── Redis ─────────────────────────────────────────────────────────────────────
# Unique prefix for this environment (avoid collisions if Redis is shared)
REDIS_KEY_PREFIX=prod:

# ── SPA build (same-origin via Caddy — leave empty) ───────────────────────────
# Empty → client uses window.location.origin at runtime.
# Only set these if the API is on a different public origin.
VITE_API_URL=
VITE_SOCKET_URL=
# CSP defaults to connect-src 'self'. For a split API origin, set EXTRA
# (include the leading space), e.g.:
# CSP_CONNECT_SRC_EXTRA= https://api.example.com wss://api.example.com
CSP_CONNECT_SRC_EXTRA=

# ── Required mail (verification, invites, password recovery) ──────────────────
# Production refuses to start without a Resend key and a sender on a verified
# non-resend.dev domain. Verify the domain before deploying.
RESEND_API_KEY=re_replace_with_production_key
MAIL_FROM="Meridian <accounts@your-verified-domain.com>"
MAIL_TIMEOUT_MS=10000
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TTL_MINUTES=1440

# ── Internal monitoring profile ──────────────────────────────────────────────
# Prometheus uses a numbered tag; Alertmanager is digest-pinned below.
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2
PROMETHEUS_RETENTION=15d
ALERTMANAGER_IMAGE=prom/alertmanager@sha256:a42c3e2e8f7cd4fd3a0ce1bd593ca5abe965c97b993476007d6f69c4a2aa33b5
# Create this mode-0600 file with exactly one approved HTTPS paging webhook URL.
ALERTMANAGER_WEBHOOK_URL_FILE=./secrets/alertmanager-webhook-url

# Terminal stays off in production (compose also forces ENABLE_TERMINAL=false)
