# npm 12.0.2 still bundles vulnerable transitive versions; pin their patched
# compatible releases until npm ships them. Image scans guard these pins.
FROM node:22-alpine3.24
COPY scripts/patch-npm.cjs /tmp/patch-npm.cjs
RUN apk add --no-cache bash python3 go tini \
    && npm install -g npm@12.0.2 tsx@4.23.13 \
    && npm install --prefix /tmp/npm-patches --omit=dev --ignore-scripts --no-package-lock \
      brace-expansion@5.0.9 ip-address@10.3.1 tar@7.5.21 \
    && node /tmp/patch-npm.cjs && rm -rf /tmp/npm-patches /tmp/patch-npm.cjs \
    && mkdir -p /workspace /opt/meridian
COPY files.py /opt/meridian/files.py
ENV HOME=/workspace TERM=xterm-256color SHELL=/bin/bash LANG=C.UTF-8 \
    GOCACHE=/tmp/go-cache GOPATH=/tmp/go PS1="\\W \\$ "
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["sleep", "infinity"]
