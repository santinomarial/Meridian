---
title: Transaction flow — Generation-fenced compaction
---
flowchart TB
    Trigger(["Local compaction threshold reached"])

    subgraph Transaction["One PostgreSQL transaction"]
        direction TB

        subgraph Guard["Lock and fence"]
            direction LR
            Lock["Acquire document<br/>advisory lock"]
            Fence{"Generation<br/>still current?"}
            Lock --> Fence
        end

        subgraph Rewrite["Reconstruct and replace"]
            direction LR
            Base["Load latest<br/>durable snapshot"]
            Updates["Replay updates through<br/>the committed cutoff"]
            Snapshot["Insert replacement<br/>snapshot"]
            Delete["Delete covered updates<br/>and older snapshots"]
            Base --> Updates --> Snapshot --> Delete
        end

        Fence -->|"yes"| Base
    end

    Trigger --> Lock
    Fence -->|"no"| Stop(["Exit without mutation"])
    Delete --> Commit(["Commit compaction"])
